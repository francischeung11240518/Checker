# Copy to .dev.vars for `npx wrangler dev`. Never commit .dev.vars.
# These values are local placeholders, not production secrets.
# Leave AUTH_ENABLED false until SESSION_SECRET and the public client ids exist.
AUTH_ENABLED=false
SESSION_SECRET=
GOOGLE_CLIENT_ID=
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=http://localhost:8080/
